@using Microsoft.AspNetCore.Identity
@inject SignInManager<Users> signInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCRM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyCRM.styles.css" asp-append-version="true" />
</head>
<body class="@(signInManager.IsSignedIn(User) ? "has-taskbar" : "")">
    @if (signInManager.IsSignedIn(User))
    {
        <aside class="taskbar" aria-label="Taskbar">
            <nav class="taskbar__icons">
                <a class="taskbar__icon taskbar__icon--active" asp-controller="Home" asp-action="Index" aria-label="Dashboard" aria-current="page" title="Dashboard">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13.5a8 8 0 1 1 16 0v5a1.5 1.5 0 0 1-1.5 1.5H17v-5h2v-1.5a7 7 0 0 0-14 0V15h2v5H5.5A1.5 1.5 0 0 1 4 18.5v-5Z"/><path d="M10 20h4v1h-4z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Contacts" title="Contacts">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0H5Z"/><path d="M18 8h2v8h-2zM17 11h4v2h-4z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Calendar" title="Calendar">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h2v3h8V3h2v3h2a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h2V3Zm-1 8v7h14v-7H5Z"/><path d="M7 13h3v3H7zM12 13h3v3h-3z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Tasks" title="Tasks">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 4v2h10V8H7Zm0 4v2h7v-2H7Zm0 4v2h10v-2H7Z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Messages" title="Messages">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 3v-3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 5v2h12V9H6Zm0 4v2h8v-2H6Z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Reports" title="Reports">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16v2H2V4h2v15Zm3-2H5v-5h2v5Zm5 0h-2V7h2v10Zm5 0h-2V4h2v13Z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Files" title="Files">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Zm2 2v10h14V7H11l-2-2H5v2Z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Settings" title="Settings">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m19.4 13.5 1.5 1.2-2 3.4-1.8-.8a7 7 0 0 1-1.6.9L15.2 20h-4l-.3-1.8a7 7 0 0 1-1.6-.9l-1.8.8-2-3.4L7 13.5a7 7 0 0 1 0-3L5.5 9.3l2-3.4 1.8.8a7 7 0 0 1 1.6-.9l.3-1.8h4l.3 1.8a7 7 0 0 1 1.6.9l1.8-.8 2 3.4-1.5 1.2a7 7 0 0 1 0 3ZM13.2 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/></svg>
                </a>
                <a class="taskbar__icon" href="#" aria-label="Help" title="Help">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 14.5a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Zm1.7-5.2-.7.5V14h-2v-2.2l1.4-1c.6-.4.9-.8.9-1.4 0-.8-.5-1.3-1.4-1.3-.8 0-1.4.5-1.6 1.3l-1.8-.6c.4-1.6 1.6-2.5 3.5-2.5 2.1 0 3.4 1.2 3.4 2.9 0 1.2-.6 2.2-1.7 3.1Z"/></svg>
                </a>
            </nav>
        </aside>
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid navbar-container">
                <div class="navbar-search">
                    <label class="visually-hidden" for="site-search">Search</label>
                    <input id="site-search" class="form-control" type="search" placeholder="Search..." />
                </div>
                <div class="navbar-top-row">
                    <span class="navbar-brand">MyCRM</span>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @for (var category = 1; category <= 7; category++)
                            {
                                <li class="nav-item dropdown">
                                    <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Kategoria @category
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Opcja 1</a></li>
                                        <li><a class="dropdown-item" href="#">Opcja 2</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Analytics">Analytics</a>
                            </li>
                            <partial name="_LoginPartial"/>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyCRM - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
