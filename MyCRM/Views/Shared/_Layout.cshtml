@using Microsoft.AspNetCore.Identity
@inject SignInManager<Users> signInManager
@{
    var isHomeController = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase);
    var showSidebar = signInManager.IsSignedIn(User) || isHomeController;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var navigation = new (string Action, string Label)[]
    {
        ("Index", "Sales"),
        ("Leads", "Leads"),
        ("Contacts", "Contacts"),
        ("Accounts", "Accounts"),
        ("Opportunities", "Opportunities"),
        ("Products", "Products"),
        ("PriceBooks", "Price Books"),
        ("Calendar", "Calendar"),
        ("Cases", "Cases"),
        ("Campaigns", "Campaigns"),
        ("Analytics", "Analytics")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCRM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyCRM.styles.css" asp-append-version="true" />
</head>
<body class="@(showSidebar ? "has-taskbar" : "")">
    @if (showSidebar)
    {
        <partial name="_Sidebar" />
    }
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom box-shadow mb-3" aria-label="CRM navigation">
            <div class="container-fluid navbar-container">
                <div class="navbar-search">
                    <label class="visually-hidden" for="site-search">Search</label>
                    <input id="site-search" class="form-control" type="search" placeholder="Search..." />
                </div>
                <div class="navbar-top-row">
                    <span class="navbar-brand">MyCRM</span>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#crm-top-navigation" aria-controls="crm-top-navigation"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="crm-top-navigation" class="navbar-collapse collapse">
                        <ul class="navbar-nav flex-grow-1">
                            @foreach (var item in navigation)
                            {
                                var isCurrent = isHomeController && string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
                                <li class="nav-item">
                                    <a class="nav-link @(isCurrent ? "active" : "")" asp-controller="Home" asp-action="@item.Action"
                                       aria-current="@(isCurrent ? "page" : null)">@item.Label</a>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyCRM - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
