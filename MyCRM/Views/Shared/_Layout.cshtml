@using Microsoft.AspNetCore.Identity
@inject SignInManager<Users> signInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCRM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyCRM.styles.css" asp-append-version="true" />
</head>
<body class="@(signInManager.IsSignedIn(User) ? "has-taskbar" : "")">
    @if (signInManager.IsSignedIn(User))
    {
        <aside class="taskbar" aria-label="Taskbar">
            <nav class="taskbar__icons">
                <a class="taskbar__icon" href="#" aria-label="Dashboard" title="Dashboard">icon1</a>
                <a class="taskbar__icon" href="#" aria-label="Contacts" title="Contacts">icon2</a>
                <a class="taskbar__icon" href="#" aria-label="Calendar" title="Calendar">icon3</a>
                <a class="taskbar__icon" href="#" aria-label="Tasks" title="Tasks">icon4</a>
                <a class="taskbar__icon" href="#" aria-label="Messages" title="Messages">icon5</a>
                <a class="taskbar__icon" href="#" aria-label="Reports" title="Reports">icon6</a>
                <a class="taskbar__icon" href="#" aria-label="Files" title="Files">icon7</a>
                <a class="taskbar__icon" href="#" aria-label="Settings" title="Settings">icon8</a>
                <a class="taskbar__icon" href="#" aria-label="Help" title="Help">icon9</a>
            </nav>
        </aside>
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid navbar-container">
                <div class="navbar-search">
                    <label class="visually-hidden" for="site-search">Search</label>
                    <input id="site-search" class="form-control" type="search" placeholder="Search..." />
                </div>
                <div class="navbar-top-row">
                    <span class="navbar-brand">MyCRM</span>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @for (var category = 1; category <= 7; category++)
                            {
                                <li class="nav-item dropdown">
                                    <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Kategoria @category
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#">Opcja 1</a></li>
                                        <li><a class="dropdown-item" href="#">Opcja 2</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Analytics">Analytics</a>
                            </li>
                            <partial name="_LoginPartial"/>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyCRM - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
